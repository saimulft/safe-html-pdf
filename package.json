{
  "name": "safe-html-pdf",
  "version": "0.1.2",
  "description": "Playwright PDF renderer for untrusted or AI-written HTML: JavaScript and network off, hard limits, and a layout lint for overflow and broken images.",
  "keywords": [
    "playwright pdf",
    "html to pdf node",
    "puppeteer html to pdf",
    "generate pdf from html",
    "html-to-pdf",
    "untrusted-html",
    "ai-generated",
    "playwright",
    "chromium",
    "headless",
    "layout-lint",
    "slides",
    "pdf"
  ],
  "homepage": "https://oss.saimulislam.com/safe-html-pdf/",
  "bugs": {
    "url": "https://github.com/saimulft/safe-html-pdf/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saimulft/safe-html-pdf.git"
  },
  "license": "MIT",
  "author": "Saimul Islam (https://github.com/saimulft)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "safe-html-pdf": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint . && npm run lint:names",
    "lint:names": "ls-lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ls-lint/ls-lint": "^2.3.2",
    "@types/node": "^20.19.43",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "~1.63.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
